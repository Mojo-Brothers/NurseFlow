<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="20dp">

        <!-- Header: Patient Name & Status -->
        <TextView
            android:id="@+id/tv_patient_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@id/tv_status_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Tn. Maruf" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tv_status_badge"
            style="@style/Widget.Material3.Chip.Suggestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/white"
            android:textSize="11sp"
            app:chipBackgroundColor="@color/status_pending"
            app:chipCornerRadius="12dp"
            app:chipMinTouchTargetSize="0dp"
            app:chipStrokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_patient_name"
            app:layout_constraintBottom_toBottomOf="@id/tv_patient_name"
            tools:text="PENDING" />

        <!-- Handover Info (Partner Name) -->
        <TextView
            android:id="@+id/tv_handover_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_patient_name"
            tools:text="Penerima: N1kd3fUb49..." />

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="16dp"
            android:background="@color/surface_background"
            app:layout_constraintTop_toBottomOf="@id/tv_handover_info" />

        <!-- Task Section Header -->
        <TextView
            android:id="@+id/label_tasks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-black"
            android:text="Realtime Task Checklist"
            android:textColor="@color/primary_purple"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/label_tasks"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/label_tasks"
            tools:text="0/3 Selesai" />

        <!-- Task List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/label_tasks"
            tools:itemCount="3"
            tools:listitem="@layout/item_handover_task" />

        <!-- Action Buttons Layout -->
        <LinearLayout
            android:id="@+id/layout_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/rv_tasks"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept_handover"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Terima"
                android:textColor="@color/white"
                app:backgroundTint="@color/status_done"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reject_handover"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-black"
                android:text="Tolak"
                android:textColor="@color/white"
                app:backgroundTint="@color/status_urgent"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- Finalize Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_complete_handover"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-black"
            android:text="Selesaikan Handover"
            android:textColor="@color/white"
            android:visibility="gone"
            app:backgroundTint="@color/primary_purple"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/rv_tasks"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
