<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.NurseFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="android:statusBarColor">@color/background_app</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/background_app</item>
    </style>

    <style name="Theme.NurseFlow" parent="Base.Theme.NurseFlow" />

    <!-- Premium Card with Smooth Corners (Apple-like) -->
    <style name="PremiumCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="android:backgroundTint">@color/surface_card</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Glassmorphism Card Style -->
    <style name="GlassCard" parent="PremiumCard">
        <item name="android:backgroundTint">@color/surface_card_glass</item>
        <item name="strokeWidth">@dimen/card_stroke_premium</item>
        <item name="strokeColor">@color/glass_stroke</item>
    </style>

    <!-- Typography Styles -->
    <style name="TextHeader" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextSubHeader" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
</resources>
