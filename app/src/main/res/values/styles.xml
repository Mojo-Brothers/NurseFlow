<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="VitalLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="VitalValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="RiskBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- 3D Glossy Glass Style -->
    <style name="GlassCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface_glass</item>
        <item name="cardCornerRadius">32dp</item>
        <item name="cardElevation">4dp</item> <!-- Soft shadow for 3D Depth -->
        <item name="strokeColor">@color/surface_glass_stroke</item>
        <item name="strokeWidth">2dp</item> <!-- Thick sharp edge for glass shine -->
        <item name="android:stateListAnimator" tools:ignore="NewApi" xmlns:tools="http://schemas.android.com/tools">@null</item>
    </style>
</resources>
